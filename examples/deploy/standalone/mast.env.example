# mast.env.example — template for /etc/mast/mast.env (root-owned,
# chmod 0600: MAST_INJECT_TOKEN is a bearer secret).

# REQUIRED: bearer token for the inject/resume/abort endpoints.
# Without it the endpoint is unauthenticated (dev only; mast logs a
# warning). Generate with: openssl rand -hex 32
MAST_INJECT_TOKEN=change-me

# Vertex AI project/location for gemini-* models (Application Default
# Credentials must also be available to the service user, e.g. via a
# GCE service account or GOOGLE_APPLICATION_CREDENTIALS).
#GOOGLE_CLOUD_PROJECT=my-project
#GOOGLE_CLOUD_LOCATION=global

# Optional: OTel trace export (no-op when unset; observability-design).
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Note: MAST_CONFIG_DIR is set in the unit file, not here, so the
# config location survives an empty/missing env file.
