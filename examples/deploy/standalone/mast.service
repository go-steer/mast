# mast.service — systemd unit for the standalone deployment shape
# (docs/deployment-design.md, "Standalone"): single mast binary on a
# Linux host, SQLite session store under /var/lib/mast.
#
# Install to /etc/systemd/system/mast.service; see the README next to
# this file for the full walkthrough (user, env file, config dir).

[Unit]
Description=mast agent runtime (unattended platform agent)
Documentation=https://github.com/go-steer/mast
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mast
Group=mast

# MAST_INJECT_TOKEN (required) and optional GOOGLE_CLOUD_* / OTel env
# live here — root-owned, mode 0600 (the token is a bearer secret).
EnvironmentFile=/etc/mast/mast.env

# Pin config discovery to the system location (config-layout-design.md
# rule 1: an explicit MAST_CONFIG_DIR is exclusive — no working-dir or
# home-dir surprises under systemd).
Environment=MAST_CONFIG_DIR=/etc/mast/agents

# StateDirectory creates /var/lib/mast owned by the service user and
# keeps it writable under ProtectSystem=strict.
StateDirectory=mast
StateDirectoryMode=0750

# Replace `my-workload` with a workload name defined under
# /etc/mast/agents/workloads/. Bind the inject endpoint to loopback
# unless something remote legitimately posts events to this host.
ExecStart=/usr/local/bin/mast \
    --workload=my-workload \
    --model=gemini-2.5-flash \
    --session-db=/var/lib/mast/sessions.db \
    --listen=127.0.0.1:7777 \
    --log-level=info

Restart=on-failure
RestartSec=5

# Hardening (safe with the flags above; loosen deliberately if your
# workload's tools need more).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
