# Copy to terraform.tfvars and edit. Everything except project_id has a
# working default; what is uncommented below is the whole required
# surface.
#
# terraform.tfvars is gitignored — it is the file most likely to acquire
# a real project ID.

project_id = "my-project"

# Namespace mast runs in. Reaches BOTH halves from here: it is part of
# the daemon's IAM identity as well as the install target.
# namespace = "mast-triage"

# Pin the chart for anything you intend to reproduce. Unset takes
# whatever the registry currently tags latest, which is fine for a first
# look and is not a declarative install.
# chart_version = "0.9.0"

# GKE Standard needs the daemon on metadata-server-enabled nodes.
# Autopilot REJECTS that selector — leave this false there.
# gke_standard = false

# The namespaces mast may CHANGE. Empty — the default — installs a mast
# that diagnoses the whole cluster and can write nowhere. Start there.
# remediation_namespaces = ["team-a", "team-b"]

# "namespaced" (default) binds roles/container.viewer and leaves the
# chart's per-namespace write Roles load-bearing. "cluster-admin" binds
# roles/container.admin, which authorizes every mutating call in every
# namespace whatever the chart renders — GKE allows a call if IAM OR RBAC
# allows it. Unlike scripts/setup-wif.sh, setting this back to
# "namespaced" actually removes the wide binding.
# write_scope = "namespaced"

# False where service enablement is somebody else's pipeline.
# enable_apis = true

# The node service account the daemon may impersonate. Empty derives the
# Compute Engine default for the project.
# node_service_account = ""

# Cluster name shown in triage context. Name it something you will
# recognise in a transcript.
# cluster_name = "local"

# Raw YAML merged over everything above, last wins — the escape hatch for
# chart values this configuration does not name. Prefer it to forking.
# extra_values = [<<-YAML
#   logLevel: debug
# YAML
# ]
