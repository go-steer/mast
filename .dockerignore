# Build artifacts + host state that shouldn't ship into the image.
/bin/
/dist/
*.exe
*.test
*.out
coverage.txt
coverage.html

# Editor / IDE / OS scratch.
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local secrets.
*.token
.env
.env.local
credentials.json
application_default_credentials.json

# Not needed by the build, and expensive to send. docs/site landed
# after this file was written; its node_modules alone is ~250MB of
# build context that the builder stage never reads.
.git/
docs/site/node_modules/
docs/site/dist/
docs/site/.astro/

# Docker-internal.
Dockerfile
.dockerignore

# Documentation not needed at runtime.
README.md
