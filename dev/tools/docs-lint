# docs-lint — prose-drift checks over the user-facing markdown, ported
# from core-agent's dev/tools/docs-lint and adapted to mast:
#
#   1. numeric tool/specialist counts   ("13 tools", "13-specialist")
#   2. hard-coded container/image/variant counts
#   3. pinned @vX.Y.Z installs of our own module
#   4. site links that hard-code the deploy base (/mast/...)
#   5. a version claim that no longer names the current release
#   6. an npm package the site imports but does not declare
#
# Rule 6 is not prose, and it is here rather than in the site build
# because the site build is not a required check — the one class of
# breakage it catches arrives as a dependency bump, which is exactly
# when nobody is reading an advisory red.
#
# core-agent's own fifth rule (wrong-MAJOR vN.X.Y prose pins) is still
# not ported, and the "revisit at v1.0" note that used to sit here was
# keyed to the wrong event (#306). It is a check on the *module major*
# in an import path, so it becomes meaningful at the first major bump
# — which #300 established can only arrive with an ADK major, since
# Go's semantic import versioning makes `adk/v3/model.LLM` a different
# type in a signature the root package exports. Re-key it there. The
# half of that rule mast actually needed — prose claiming a release
# that is not the current one — is rule 5 above, and it is needed
# regardless of major.
#
# Usage: dev/tools/docs-lint            scan
#        dev/tools/docs-lint --self-test  verify the rules still fire

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

scoped_paths() {
  # README + DESIGN + all Astro Starlight site content markdown.
  # Nothing under docs/*.md at the top level (design docs cite
  # versions/counts as historical record), nothing under CHANGELOG.md
  # (version headers and shipped-scope counts are the point there).
  #
  # DESIGN.md is in scope even though the docs/ exclusion sits right
  # next to it, because the reason for that exclusion does not reach
  # it: it is at the repo root, it is the architecture map of what
  # actually ships rather than a historical record, and it is item 2
  # in AGENTS.md's required reading order. It was out of scope only
  # because this list named README.md by hand and nobody added its
  # sibling — which is how its title sat at "(v0.5)" through a release
  # with docs-lint green (#306).
  find README.md DESIGN.md docs/site/src/content -type f \( -name '*.md' -o -name '*.mdx' \) 2>/dev/null | sort
}

# The release this working tree claims to be, read from the newest
# released CHANGELOG heading rather than from `git describe`.
#
# Deliberate, and the ordering is the whole point: the release-prep PR
# rolls the changelog AND corrects every version claim in one commit,
# and the tag is cut on the merge of that PR (v0.7.0 is literally
# `1882dfb`, "roll the changelog for v0.7.0, and make every version
# claim true at the tag"). At the moment this rule runs on that PR the
# heading is already right and the tag does not exist yet, so reading
# the tag would red the one PR whose job is making these claims true.
# A shallow CI checkout carries no tags either, and a rule that
# silently skips when it cannot find a version is the exact failure
# mode #306 is about — so this is fatal rather than quiet.
current_release() {
  local v
  v=$(sed -n 's/^## \(v[0-9][0-9.]*\).*/\1/p' CHANGELOG.md 2>/dev/null | head -1)
  if [[ -z "$v" ]]; then
    echo "docs-lint: cannot determine the current release: no '## vX.Y.Z' heading in CHANGELOG.md" >&2
    exit 2
  fi
  printf '%s\n' "$v"
}

# Check 1: numeric tool/specialist counts in prose. Both drift on
# every roster or catalog change; name the categories instead.
check_tool_counts() {
  local path="$1"
  awk -v p="$path" '
    # Skip lines that look like directory-tree entries or contain a
    # markdown/go filename — these are code-shaped, not prose.
    /^[ \t│├└─┌┐┘┴┬┼]+/ && /\.(md|go|yaml|yml|json|sh|ts|tsx|py)/ { next }

    # Digit form, hyphenated: "13-tool(s)" / "13-specialist(s)" only
    # when followed by a sentence delimiter, not another hyphen.
    match($0, /(^|[^A-Za-z0-9])[0-9]+-(tools?|specialists?)([ .,;:)]|$)/) {
      printf "%s:%d: numeric tool/specialist count — name the categories or the roster instead of a count that drifts on every change\n", p, NR
      next
    }
    # Digit form, space-separated. Require the PLURAL to avoid
    # matching "20 tool-heavy" style adjectives.
    match($0, /(^|[^A-Za-z0-9])[0-9]+ (tools|specialists)\b/) {
      printf "%s:%d: numeric tool/specialist count — name the categories or the roster instead of a count that drifts on every change\n", p, NR
      next
    }
    # Spelled form: Ten..Twenty [space or hyphen] tool[s]/specialist[s].
    match($0, /(^|[^A-Za-z])(Ten|Eleven|Twelve|Thirteen|Fourteen|Fifteen|Sixteen|Seventeen|Eighteen|Nineteen|Twenty)[- ]?(tools?|specialists?)/) {
      printf "%s:%d: spelled tool/specialist count — name the categories or the roster instead of a count that drifts on every change\n", p, NR
    }
  ' "$path"
}

# Check 2: hard-coded container/image/variant counts.
check_image_counts() {
  local path="$1"
  grep -n -E '\b(two|three|four|five|six|seven|[2-9]|1[0-9])[- ]?(container|image|variant)s?\b' "$path" 2>/dev/null | \
    awk -F: -v p="$path" '{
      msg = "hard-coded container/image/variant count — describe variants by name or use a table";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

# Check 3: pinned @vX.Y.Z in a go get / go install snippet referencing
# our own module. Use @latest (or a shell variable) instead.
check_pinned_installs() {
  local path="$1"
  grep -n -E 'go (get|install)\s+github\.com/go-steer/mast[^ ]*@v[0-9]+\.[0-9]+\.[0-9]+' "$path" 2>/dev/null | \
    awk -F: -v p="$path" '{
      msg = "pinned @vX.Y.Z in install snippet — use @latest so the doc doesn'\''t rot after the next release";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

# Check 4: a content link that hard-codes the deploy base. The
# remark-prepend-base plugin adds Astro's `base` to every root-relative
# markdown link at build time, so content is supposed to say
# `/reference/cli/`. A link that already says `/mast/reference/cli/` is
# skipped by the plugin — it works today and silently 404s the day the
# base changes, which is the one event the plugin exists to survive.
check_hardcoded_base() {
  local path="$1"
  grep -n -E '\]\(/mast/' "$path" 2>/dev/null | \
    awk -F: -v p="$path" '{
      msg = "link hard-codes the deploy base — write (/reference/...); remark-prepend-base adds /mast at build time";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

# Check 5: a version claim that no longer names the current release.
#
# Deliberately anchored to specific phrasings rather than to "any
# vX.Y.Z in the file". Most version strings in user-facing prose are
# legitimate history — the roadmap's "Shipped in v0.5.0", install.md's
# "on the v0.6.0 enforcement pass", a "(they return not_implemented in
# the v0.2 scaffold)" aside — and a rule that reds those would be
# turned off within a release. What is checked is the small set of
# places that are claims about *now*:
#
#   a. "Current release: vX.Y.Z" / "current as of vX.Y.Z"
#   b. a document H1 that carries a parenthesised version
#   c. a release-asset download URL
#   d. a release-asset filename, and the "Assets for vX.Y.Z" line
#      above it
#
# (c) and (d) are the ones that actually hurt: install.md sat at
# v0.4.0 for three releases *including its copy-paste download URLs*,
# so a reader following the page got a 404 rather than a stale
# adjective.
check_stale_version() {
  local path="$1" cur="$2"
  local curmm="${cur%.*}"        # v0.7.0 -> v0.7
  local curbare="${cur#v}"       # v0.7.0 -> 0.7.0
  awk -v p="$path" -v cur="$cur" -v curmm="$curmm" -v curbare="$curbare" '
    function ver(s,   r) {
      if (match(s, /[0-9]+\.[0-9]+\.[0-9]+/)) return substr(s, RSTART, RLENGTH)
      if (match(s, /[0-9]+\.[0-9]+/)) return substr(s, RSTART, RLENGTH)
      return ""
    }
    function report(got, what) {
      printf "%s:%d: stale version claim — %s says v%s, the current release is %s\n", p, NR, what, got, cur
    }

    # (a) a status line making a claim about the current release.
    match($0, /([Cc]urrent release|[Cc]urrent as of)[^0-9]*[0-9]+\.[0-9]+\.[0-9]+/) {
      got = ver(substr($0, RSTART, RLENGTH))
      if (got != "" && got != curbare) report(got, "this status line")
    }

    # (b) a document title carrying a parenthesised version. Compared
    # at whatever precision it is written: "(v0.7)" against the
    # major.minor, "(v0.7.0)" against the full version.
    /^# / && match($0, /\(v[0-9]+\.[0-9]+(\.[0-9]+)?\)/) {
      got = ver(substr($0, RSTART, RLENGTH))
      want = (got ~ /^[0-9]+\.[0-9]+\.[0-9]+$/) ? curbare : substr(curmm, 2)
      if (got != want) report(got, "this document title")
    }

    # (c) a release-asset download URL. A wrong one 404s.
    match($0, /releases\/download\/v[0-9]+\.[0-9]+\.[0-9]+/) {
      got = ver(substr($0, RSTART, RLENGTH))
      if (got != curbare) report(got, "this download URL")
    }

    # (d) a release-asset filename, or the line introducing them.
    match($0, /mast_[0-9]+\.[0-9]+\.[0-9]+_/) {
      got = ver(substr($0, RSTART, RLENGTH))
      if (got != curbare) report(got, "this release asset name")
      next
    }
    match($0, /[Aa]ssets for v[0-9]+\.[0-9]+\.[0-9]+/) {
      got = ver(substr($0, RSTART, RLENGTH))
      if (got != curbare) report(got, "this assets line")
    }
  ' "$path"
}

# Check 6: an npm package the site's own JavaScript imports must be
# declared in docs/site/package.json.
#
# `astro.config.mjs` imported `@astrojs/markdown-remark` for a year
# without declaring it, and resolved every time — npm had hoisted it to
# the top of node_modules as a transitive dependency of astro. A
# Starlight minor bump reshuffled the tree, the hoist stopped, and the
# site build died with `Cannot find module`. Nothing in the repo
# changed; a package two levels away did.
#
# The rule is repo-wide rather than per-file, and it takes its inputs as
# arguments so the self-test can feed it fixtures — a resolver checked
# only against the tree it was written for is a resolver that passes by
# construction.
#
# Node builtins, relative paths and absolute paths are not packages. A
# scoped specifier contributes its first two segments (`@astrojs/x`),
# a bare one its first (`astro` from `astro/config`).
check_site_imports_declared() {
  local pkg="$1"
  shift
  [[ -f "$pkg" ]] || { echo "docs-lint: $pkg not found"; return; }

  # Keys of the dependencies / devDependencies objects. The closing
  # brace is matched at the object's own indent, so a nested object
  # would end the block early rather than leak into it.
  local declared
  declared=$(awk '
    /"(dependencies|devDependencies)"[[:space:]]*:[[:space:]]*\{/ { inblock = 1; next }
    inblock && /^[[:space:]]*\}/ { inblock = 0; next }
    inblock && match($0, /"[^"]+"/) { print substr($0, RSTART + 1, RLENGTH - 2) }
  ' "$pkg")

  local src spec name
  for src in "$@"; do
    [[ -f "$src" ]] || continue
    while IFS= read -r spec; do
      case "$spec" in
        .* | /* | node:*) continue ;;
      esac
      if [[ "$spec" == @* ]]; then
        name=$(printf '%s\n' "$spec" | cut -d/ -f1-2)
      else
        name=${spec%%/*}
      fi
      grep -qxF "$name" <<<"$declared" || printf '%s: imports %s, which %s does not declare — it resolves only for as long as npm hoists it out of another package'"'"'s tree, and the dependency bump that stops hoisting it breaks the site build with no change to this repo\n' "$src" "$name" "$pkg"
    done < <(grep -hoE "from[[:space:]]+['\"][^'\"]+['\"]" "$src" 2>/dev/null |
      sed -E "s/.*['\"]([^'\"]+)['\"]/\1/" | sort -u)
  done
}

# The site's own JavaScript — its Astro config and the remark plugins
# it loads. Everything else under docs/site is content or node_modules.
site_js_paths() {
  find docs/site/astro.config.mjs docs/site/src -type f \
    \( -name '*.mjs' -o -name '*.js' \) 2>/dev/null | sort
}

# ---- driver -----------------------------------------------------------

run_all_checks() {
  local findings=0
  local cur
  cur=$(current_release)
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    local out
    out=$(
      check_tool_counts "$path"
      check_image_counts "$path"
      check_pinned_installs "$path"
      check_hardcoded_base "$path"
      check_stale_version "$path" "$cur"
    )
    if [[ -n "$out" ]]; then
      printf '%s\n' "$out"
      findings=$((findings + $(printf '%s\n' "$out" | wc -l)))
    fi
  done < <(scoped_paths)

  # Rule 6 is about the site as a whole, not about any one page, so it
  # runs once rather than per scoped path.
  local deps
  # shellcheck disable=SC2046
  deps=$(check_site_imports_declared docs/site/package.json $(site_js_paths))
  if [[ -n "$deps" ]]; then
    printf '%s\n' "$deps"
    findings=$((findings + $(printf '%s\n' "$deps" | wc -l)))
  fi

  if (( findings > 0 )); then
    echo ""
    echo "docs-lint: $findings finding(s). See remediation hints above."
    echo "Reference: dev/tools/docs-lint --self-test to see each rule in action."
    return 1
  fi
  echo "docs-lint: OK"
  return 0
}

# ---- self-test --------------------------------------------------------
#
# Writes a fixture into a temp dir and verifies every rule fires at
# least once, so regex edits can't silently defang a rule.

self_test() {
  local tmp
  tmp=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT

  cat > "$tmp/fixture.md" <<'EOF'
# Fixture

The 13-tool built-in catalog is stale phrasing.
The 13-specialist roster is the same trap.
Thirteen specialists are registered by default.

We ship three container images.

Install with:

```
go get github.com/go-steer/mast/cmd/mast@v0.1.0
```

See the [CLI reference](/mast/reference/cli/) — a link that hard-codes the base.
EOF

  # Rule 5 needs its own fixture: the file's own H1 carries a version,
  # and the stale strings are compared against a *pinned* synthetic
  # release (v9.9.9) rather than against whatever CHANGELOG.md says
  # today — otherwise the self-test would change verdict on release
  # day. The stale strings below are the two real instances from #288.
  cat > "$tmp/version.md" <<'EOF'
# mast — architecture (v0.5)

**Status:** current as of v0.5.0 (2026-08-30).

Current release: **v0.4.0** — two releases stale, and docs-lint read
this line on every CI run.

Assets for v0.4.0:

- `mast_0.4.0_linux_amd64.tar.gz`

```sh
curl -fsSLO https://github.com/go-steer/mast/releases/download/v0.4.0/mast_0.4.0_linux_amd64.tar.gz
```

Legitimate history, which must NOT fire: shipped in v0.5.0, on the
v0.4.0 change set, and the v0.2 scaffold returns not_implemented.
EOF

  # The other half of the rule: a page that is correct must stay
  # silent. A check that fires on everything is as useless as one that
  # fires on nothing, and this is the half a broad "any vX.Y.Z" regex
  # would fail.
  cat > "$tmp/version-ok.md" <<'EOF'
# mast — architecture (v9.9)

**Status:** current as of v9.9.9 (2026-09-11).

Current release: **v9.9.9**.

Assets for v9.9.9:

- `mast_9.9.9_linux_amd64.tar.gz`

Shipped in v0.5.0, on the v0.4.0 change set, in the v0.2 scaffold.
EOF

  # Rule 6 needs a package.json and a source file rather than a page.
  # `astro` is declared and imported deep (`astro/config`), so the rule
  # has to compare package names and not specifiers; `@astrojs/starlight`
  # is declared and scoped; `unified` and `@astrojs/markdown-remark` are
  # the shape the bug had. The relative, absolute and `node:` imports are
  # not packages and must stay silent.
  cat > "$tmp/package.json" <<'EOF'
{
  "name": "fixture",
  "dependencies": {
    "astro": "^7.1.0",
    "@astrojs/starlight": "^0.41.0"
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  }
}
EOF

  cat > "$tmp/config.mjs" <<'EOF'
import { defineConfig } from 'astro/config';
import starlight from '@astrojs/starlight';
import { unified } from '@astrojs/markdown-remark';
import { visit } from 'unist-util-visit';
import { readFile } from 'node:fs/promises';
import format from 'prettier';
import local from './plugins/base.mjs';
import rooted from '/opt/fixture/thing.mjs';
EOF

  local out=0
  local n
  n=$(check_tool_counts "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_tool_counts fired 0 times, expected ≥1"; out=1; }

  n=$(check_image_counts "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_image_counts fired 0 times, expected ≥1"; out=1; }

  n=$(check_pinned_installs "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_pinned_installs fired 0 times, expected ≥1"; out=1; }

  n=$(check_hardcoded_base "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_hardcoded_base fired 0 times, expected ≥1"; out=1; }

  # Rule 5, per phrasing rather than per count: a regex edit that
  # defangs one of the four shapes should name which one.
  local stale
  stale=$(check_stale_version "$tmp/version.md" "v9.9.9")
  local what
  for what in "this document title" "this status line" "this download URL" \
              "this release asset name" "this assets line"; do
    grep -qF "$what" <<<"$stale" || {
      echo "self-test: check_stale_version did not fire on \"$what\""; out=1; }
  done
  # Both "current release:" and "current as of" are status lines.
  n=$(grep -cF "this status line" <<<"$stale" || true)
  (( n >= 2 )) || { echo "self-test: check_stale_version caught $n status line(s), expected 2"; out=1; }
  # And no finding may land on the legitimate-history line.
  grep -q ':2[0-9]*: .*v0\.2' <<<"$stale" && {
    echo "self-test: check_stale_version fired on legitimate historical prose"; out=1; }

  n=$(check_stale_version "$tmp/version-ok.md" "v9.9.9" | wc -l)
  (( n == 0 )) || {
    echo "self-test: check_stale_version fired $n time(s) on an up-to-date page, expected 0"
    check_stale_version "$tmp/version-ok.md" "v9.9.9"
    out=1; }

  # Rule 6, named rather than counted for the same reason as rule 5:
  # the two ways to defang it are to stop resolving scopes and to start
  # treating builtins as packages, and both should say which.
  local undeclared
  undeclared=$(check_site_imports_declared "$tmp/package.json" "$tmp/config.mjs")
  local want
  for want in "@astrojs/markdown-remark" "unist-util-visit"; do
    grep -qF "imports $want," <<<"$undeclared" || {
      echo "self-test: check_site_imports_declared did not fire on \"$want\""; out=1; }
  done
  for want in "astro" "@astrojs/starlight" "prettier" "node:fs/promises" "./plugins/base.mjs" "/opt/fixture/thing.mjs"; do
    grep -qF "imports $want," <<<"$undeclared" && {
      echo "self-test: check_site_imports_declared fired on \"$want\", which it should not"; out=1; }
  done
  n=$(printf '%s' "$undeclared" | grep -c . || true)
  (( n == 2 )) || {
    echo "self-test: check_site_imports_declared reported $n finding(s), expected 2"
    printf '%s\n' "$undeclared"
    out=1; }

  if (( out == 0 )); then
    echo "docs-lint self-test: OK (all 6 rules fired on the fixtures, and rules 5 and 6 stayed silent on the clean ones)"
  fi
  return $out
}

# ---- entry point ------------------------------------------------------

case "${1:-}" in
  --self-test) self_test ;;
  "") run_all_checks ;;
  *) echo "usage: dev/tools/docs-lint [--self-test]" >&2; exit 2 ;;
esac
