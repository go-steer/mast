# ci — local CI runner. Delegates to dev/ci/presubmits/all.sh, which runs
# the exact presubmit scripts .github/workflows/ci.yml executes.

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

if [[ -d "${HOME:-}/.local/bin" && ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
  export PATH="${HOME}/.local/bin:${PATH}"
fi

# Align local Go, gofmt, and govulncheck with go.mod's pinned toolchain so
# local runs match actions/setup-go (go-version-file: go.mod) in CI.
tc_pin="$(awk '$1 == "toolchain" { print $2; exit }' go.mod || true)"
if [[ -z "$tc_pin" ]]; then
  go_ver="$(awk '$1 == "go" && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+$/ { print $2; exit }' go.mod || true)"
  [[ -n "$go_ver" ]] && tc_pin="go${go_ver}"
fi
if [[ -n "$tc_pin" ]]; then
  if tc_root="$(GOTOOLCHAIN="$tc_pin" go env GOROOT 2>/dev/null)" && [[ -d "$tc_root/bin" ]]; then
    export GOTOOLCHAIN="$tc_pin"
    export PATH="${tc_root}/bin:${PATH}"
  fi
fi

exec dev/ci/presubmits/all.sh "$@"
