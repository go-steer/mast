# Binaries (when code lands post-fork).
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries.
*.test

# Coverage profiles + other test artifacts.
*.out
coverage.*
*.coverprofile
profile.cov

# Project-specific binaries (built from ./cmd/... and ./examples/... post-fork).
/mast
/cmd/mast/mast

# AI assistant working state — never committed to this repo.
.claude/

# Per-user .agents/ state (if mast develops one post-fork).
/.agents/sessions/
/.agents/logs/

# Terraform working state under examples/deploy/terraform.
#
# The lock file is ignored deliberately. examples/ is a configuration
# people copy and adapt rather than one we apply, and a lock committed
# from CI records provider hashes for linux_amd64 only — `terraform init`
# on a macOS laptop then fails on a checksum until the reader knows to run
# `terraform providers lock -platform=darwin_arm64`. Pinning belongs in
# the copy, where it can be locked for the platforms that copy is applied
# from.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
# terraform.tfvars is the file most likely to acquire a real project ID;
# terraform.tfvars.example does not match this pattern and is committed.
*.tfvars

# Local environment overrides.
.env
.env.local

# Editor / IDE noise.
.idea/
.vscode/
.DS_Store
*.swp

# Personal working notes — kept on disk but not in version control.
